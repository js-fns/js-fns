{
  "name": "js-fns",
  "version": "4.1.0",
  "description": "JavaScript utility library",
  "license": "MIT",
  "author": "Sasha Koss <koss@nocorp.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/js-fns/js-fns.git"
  },
  "type": "module",
  "main": "index.cjs",
  "module": "index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./canon": "./src/canon/index.ts",
    "./decimal": "./src/decimal/index.ts",
    "./promise": "./src/promise/index.ts",
    "./rpc": "./src/rpc/index.ts",
    "./rpc/birpc": "./src/rpc/birpc/index.ts",
    "./rpc/transports/worker": "./src/rpc/transports/worker/index.ts"
  },
  "publishConfig": {
    "main": "index.cjs",
    "module": "index.js",
    "types": "./index.d.ts",
    "exports": {
      ".": {
        "require": {
          "types": "./index.d.cts",
          "default": "./index.cjs"
        },
        "import": {
          "types": "./index.d.ts",
          "default": "./index.js"
        }
      },
      "./package.json": "./package.json",
      "./canon": {
        "require": {
          "types": "./canon/index.d.cts",
          "default": "./canon/index.cjs"
        },
        "import": {
          "types": "./canon/index.d.ts",
          "default": "./canon/index.js"
        }
      },
      "./decimal": {
        "require": {
          "types": "./decimal/index.d.cts",
          "default": "./decimal/index.cjs"
        },
        "import": {
          "types": "./decimal/index.d.ts",
          "default": "./decimal/index.js"
        }
      },
      "./promise": {
        "require": {
          "types": "./promise/index.d.cts",
          "default": "./promise/index.cjs"
        },
        "import": {
          "types": "./promise/index.d.ts",
          "default": "./promise/index.js"
        }
      },
      "./rpc": {
        "require": {
          "types": "./rpc/index.d.cts",
          "default": "./rpc/index.cjs"
        },
        "import": {
          "types": "./rpc/index.d.ts",
          "default": "./rpc/index.js"
        }
      },
      "./rpc/birpc": {
        "require": {
          "types": "./rpc/birpc/index.d.cts",
          "default": "./rpc/birpc/index.cjs"
        },
        "import": {
          "types": "./rpc/birpc/index.d.ts",
          "default": "./rpc/birpc/index.js"
        }
      },
      "./rpc/transports/worker": {
        "require": {
          "types": "./rpc/transports/worker/index.d.cts",
          "default": "./rpc/transports/worker/index.cjs"
        },
        "import": {
          "types": "./rpc/transports/worker/index.d.ts",
          "default": "./rpc/transports/worker/index.js"
        }
      }
    }
  },
  "devDependencies": {
    "@js-fns/dev": "workspace:*"
  }
}
